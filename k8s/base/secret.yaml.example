# Template only — copy to secret.yaml, fill in real values, and apply directly with
# `kubectl apply -f`. Never commit the filled-in secret.yaml (it's gitignored).
#
# Prefer a real secret manager for production (Vault, Sealed Secrets, External Secrets
# Operator, cloud KMS-backed secrets) over plain Kubernetes Secrets where possible.
apiVersion: v1
kind: Secret
metadata:
  name: ssm-service-secrets
  namespace: ssm
type: Opaque
stringData:
  SSM_DATASOURCE_USERNAME: "ssm"
  SSM_DATASOURCE_PASSWORD: "CHANGE_ME"
  SSM_REDIS_PASSWORD: "CHANGE_ME"
  SSM_KEYSTORE_PASSWORD: "CHANGE_ME"
  SSM_KEY_PASSWORD: "CHANGE_ME"
